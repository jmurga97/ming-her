        "unicorn/switch-case-break-position": "error",
        "unicorn/text-encoding-identifier-case": "error",
        "unicorn/throw-new-error": "error",
        "eqeqeq": ["error", "always"],
        "max-depth": ["error", 2],
        "max-lines-per-function": [
          "error",
          {
            "max": 80,
            "skipBlankLines": true,
            "skipComments": true,
          },
        ],
        "max-params": ["error", 2],
        "no-console": [
          "error",
          {
            "allow": ["error", "log"],
          },
        ],
        "no-warning-comments": [
          "error",
          {
            "location": "anywhere",
            "terms": ["fix", "fixme", "todo", "xxx"],
          },
        ],
        "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
        "import/newline-after-import": "error",
        "import/no-duplicates": "error",
        // Import ordering is an Oxlint policy (oxfmt sortImports deliberately stays off).
        // eslint-plugin-import runs under the x-import alias; oxlint's native "import" plugin
        // has no order rule and the "import" jsPlugin name is reserved.
        "x-import/order": [
          "error",
          {
            "groups": ["builtin", "external", "internal", ["parent", "sibling", "index"], "type"],
            "newlines-between": "always",
            "alphabetize": { "order": "asc", "caseInsensitive": true },
          },
        ],
        "typescript/consistent-type-imports": [
          "error",
          {
            "prefer": "type-imports",
            "fixStyle": "separate-type-imports",
          },
        ],
        "typescript/switch-exhaustiveness-check": "error",
      },
      "plugins": ["typescript", "unicorn", "import"],
      "jsPlugins": [{ "name": "x-import", "specifier": "eslint-plugin-import" }, "eslint-plugin-sonarjs"],
    },
    {
      "files": ["apps/admin/src/**/*.{ts,tsx}", "apps/web/src/**/*.{ts,tsx}"],
