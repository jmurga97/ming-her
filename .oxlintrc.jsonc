      },
      "jsPlugins": ["@tanstack/eslint-plugin-query", "@tanstack/eslint-plugin-router"],
      "plugins": ["react", "jsx-a11y"],
      "env": {
        "browser": true,
      },
    },
    {
      // react-hook-form's `field` and controller objects are ref-shaped, so react/refs flags every
      // property read off them. apps/admin is not compiled by React Compiler, so the rule stays off
      // there; it remains an error in apps/web (was warn pre-migration, diff approved in lint-migration.md).
      "files": ["apps/admin/src/**/*.{ts,tsx}"],
      "rules": {
        "react/refs": "off",
      },
      "plugins": ["react"],
    },
    {
      "files": ["apps/admin/src/app/routes/**/*.{ts,tsx}", "apps/web/src/app/routes/**/*.{ts,tsx}"],
      "rules": {
        "unicorn/filename-case": "off",
        "react/only-export-components": "off",
      },
      "plugins": ["react", "unicorn"],
    },
    {
      "files": ["apps/api/src/**/*.ts"],
      "env": {
        "serviceworker": true,
        "worker": true,
      },
    },
